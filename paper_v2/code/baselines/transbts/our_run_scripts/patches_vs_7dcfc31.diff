 from scipy import ndimage
 
 
+def nii_f32b0(path, has_label=True):
+    # 2026-10-14 (our run): same as data/preprocess.py process_f32b0 (modalities flair, t1ce, t1, t2; float32; z-score over
+    # the brain mask, background kept 0), computed on load instead of caching 1,251 x 143 MB pickles on the HDD.
+    import nibabel as nib
+    images = np.stack([np.array(nib.load(path + m + '.nii.gz').dataobj, dtype='float32', order='C')
+                       for m in ('flair', 't1ce', 't1', 't2')], -1)
+    mask = images.sum(-1) > 0
+    for k in range(4):
+        x = images[..., k]; y = x[mask]
+        x[mask] -= y.mean(); x[mask] /= y.std(); images[..., k] = x
+    if not has_label:
+        return images
+    label = np.array(nib.load(path + 'seg.nii.gz').dataobj, dtype='uint8', order='C')
+    return images, label
+
+
